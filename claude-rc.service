[Unit]
Description=Claude Code Remote Control server
Documentation=https://claude.ai/code

[Service]
Type=simple
# Sessions spawned from claude.ai/code or the mobile app work in this directory.
WorkingDirectory=%h/projects
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude remote-control
# stdout is a status line redrawn every second; keep it out of the journal.
StandardOutput=null
StandardError=journal
# Network may not be up yet at login; keep retrying.
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
